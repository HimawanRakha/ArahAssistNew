# Connection string Neon Postgres (Dashboard Neon > Connect > pilih "Pooled connection").
# Jika dikosongkan, aplikasi memakai database lokal PGlite di ./.data/pglite (hanya untuk development).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# API key Google Gemini (https://aistudio.google.com/apikey).
# Jika dikosongkan, rencana dipecah oleh parser lokal tanpa AI.
GEMINI_API_KEY=""
# Opsional. Daftar model dipisah koma, dicoba berurutan sebagai cadangan saat model sibuk.
GEMINI_MODEL="gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash"

# Rahasia untuk menandatangani cookie sesi. Wajib di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Notifikasi pengingat di HP (PWA + web push). Jika kosong, kartu "Pengingat di HP" di Workspace tidak aktif.
# Buat sepasang kunci dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Kontak pemilik server push (URL situs atau mailto:email).
VAPID_SUBJECT="https://arah-assist.vercel.app"
# Token rahasia untuk penjadwal /api/cron/reminders (dipanggil tiap menit oleh layanan cron).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
